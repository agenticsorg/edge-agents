    "directory": "scripts/agentic-mcp"
  },
  "homepage": "https://ruv.io",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.80.0",
    "dotenv": "^16.6.1",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
